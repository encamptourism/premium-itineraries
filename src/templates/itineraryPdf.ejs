<style>
  @import url('https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Luxurious+Roman&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap');

  #encamp-pdf-template {
    font-family: 'Poppins', 'Plus Jakarta Sans', sans-serif !important;
  }

  .pdf-font-serif {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
  }

  .pdf-font-script {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-style: italic !important;
  }

  .pdf-font-roman {
    font-family: 'Luxurious Roman', 'Cormorant Garamond', serif !important;
  }

  .pdf-font-sans {
    font-family: 'Poppins', 'Plus Jakarta Sans', sans-serif !important;
  }

  @media print {
    @page {
      size: A4 portrait;
      margin: 10mm 0mm 31.36mm 0mm;
    }
    body {
      margin: 0 !important;
      padding: 0 !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    #encamp-pdf-template {
      width: 100% !important;
      max-width: 100% !important;
      padding: 0 14mm !important;
      box-sizing: border-box !important;
      margin: 0 auto !important;
    }
    .html-only-footer {
      display: none !important;
    }
  }
</style>

<div id="encamp-pdf-template"
  style="width: 730px; max-width: 730px; background-color: #FFFFFF; color: #232323; font-family: 'Poppins', 'Plus Jakarta Sans', sans-serif; padding: 16px; border: none; box-sizing: border-box; margin: 0 auto;">

  <!-- ========================================================================= -->
  <!-- 1. FIRST PAGE TOP DOCUMENT HEADER -->
  <!-- ========================================================================= -->
  <header
    style="display: flex; align-items: flex-start; justify-content: space-between; padding: 12px 16px; border-bottom: 2px solid #123B2A; background-color: #123B2A; color: #FFFFFF; border-radius: 14px; margin-bottom: 14px; box-sizing: border-box; page-break-inside: avoid; break-inside: avoid;">
    <!-- Left Side: Logo & Brand (Starts from Top) -->
    <div style="display: flex; align-items: flex-start; gap: 12px;">
      <% if (encampLogoSrc) { %>
        <img src="<%= encampLogoSrc %>" alt="Encamp Privé" style="height: 38px; width: auto; object-fit: contain; display: block; margin: 0;" />
      <% } else { %>
        <div style="width: 32px; height: 32px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); display: flex; align-items: center; justify-content: center; color: #FFFFFF; flex-shrink: 0;">
          <svg style="width: 18px; height: 18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
          </svg>
        </div>
      <% } %>
      <div style="display: flex; flex-direction: column; justify-content: flex-start; align-items: flex-start; padding-top: 0; margin-top: 0;">
        <h1 style="font-size: 16px; font-weight: 700; letter-spacing: 2px; color: #FFFFFF; text-transform: uppercase; margin: 0 0 2px 0; padding: 0; line-height: 1;" class="pdf-font-serif">
          ENCAMP PRIVÉ
        </h1>
        <p style="font-size: 8px; color: #E5E7EB; font-weight: 400; letter-spacing: 0.8px; text-transform: uppercase; margin: 0; padding: 0; line-height: 1.1;" class="pdf-font-sans">
          Bespoke Luxury Expeditions & Private Journeys
        </p>
      </div>
    </div>

    <!-- Right Side: Company Details (ENCAMP PRIVÉ Header) -->
    <div style="text-align: right; flex-shrink: 0; font-size: 8.5px; color: #E5E7EB; line-height: 1.35; padding-top: 0;" class="pdf-font-sans">
      <div style="font-weight: 700; color: #F5DC9A; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; line-height: 1;">ENCAMP PRIVÉ</div>
      <div>Guwahati, Assam – 781028 &nbsp;•&nbsp; support@encampadventures.com</div>
      <div>+91 96431 82259 &nbsp;•&nbsp; www.encampadventures.com</div>
    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- 2. HERO COVER SECTION -->
  <!-- ========================================================================= -->
  <section
    style="position: relative; width: 100%; height: 350px; border-radius: 20px; overflow: hidden; border: none; background-color: #111827; display: flex; flex-direction: column; justify-content: space-between; padding: 14px 16px; box-sizing: border-box; margin-bottom: 16px; page-break-inside: avoid; break-inside: avoid;">
    <% if (heroImageSrc) { %>
      <img src="<%= heroImageSrc %>" alt="<%= itinerary.title %>"
        style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.68);" />
      <% } %>
        <div
          style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.2) 40%, rgba(0,0,0,0.85) 100%);">
        </div>

        <!-- Top Right Logo Header -->
        <div
          style="position: relative; z-index: 10; display: flex; justify-content: flex-end; align-items: center; width: 100%;">
          <% if (encampLogoSrc) { %>
            <img src="<%= encampLogoSrc %>" alt="Encamp Adventures"
              style="height: 38px; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.6));" />
            <% } else { %>
              <span
                style="font-size: 10px; font-weight: 700; color: #FFFFFF; text-transform: uppercase; letter-spacing: 1.5px; background-color: rgba(0,0,0,0.6); padding: 4px 12px; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.4);"
                class="pdf-font-serif">
                ENCAMP PRIVÉ
              </span>
              <% } %>
        </div>

        <!-- Center Title / Logo, Subtitle (Cormorant Garamond Italic), Duration Ribbon -->
        <div style="position: relative; z-index: 10; text-align: center; margin: auto 0; padding: 4px 0;">
          <% if (hindiLogoSrc) { %>
            <div style="display: flex; justify-content: center; margin-bottom: 2px;">
              <img src="<%= hindiLogoSrc %>" alt="<%= itinerary.title %>"
                style="max-height: 100px; max-width: 480px; object-fit: contain; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.7));" />
            </div>
            <% } else { %>
              <h2
                style="font-size: 28px; font-weight: 700; text-transform: uppercase; color: #FFFFFF; letter-spacing: 2px; text-shadow: 0 3px 6px rgba(0,0,0,0.9); margin: 0 0 4px 0;"
                class="pdf-font-serif">
                <%= itinerary.title %>
              </h2>
              <% } %>

                <% if (itinerary.subtitle) { %>
                  <p style="font-size: 16px; font-weight: 400; color: #F5E6A3; text-shadow: 0 2px 4px rgba(0,0,0,0.8); margin: 0 0 6px 0; line-height: 1.2;"
                    class="pdf-font-script">
                    <%= itinerary.subtitle %>
                  </p>
                  <% } %>

                    <% if (durationText) { %>
                      <!-- Duration Ribbon Badge with Fixed Height, Pill Border Radius & Perfect Vertical Centering -->
                      <div style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 16px; margin-bottom: 8px; width: 100%;">
                        <span style="height: 2px; width: 60px; background-color: #64161B; opacity: 0.85; display: inline-block;"></span>
                        <div
                          style="background-color: #64161B; color: #FFFDF5; border: 1.5px solid rgba(255, 255, 255, 0.7); border-radius: 9999px; height: 28px; padding: 0 22px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; text-align: center; box-sizing: border-box; box-shadow: 0 2px 6px rgba(0,0,0,0.4);"
                          class="pdf-font-roman">
                          <span style="display: inline-block; line-height: 1; margin-right: -2px;"><%= durationText %></span>
                        </div>
                        <span style="height: 2px; width: 60px; background-color: #64161B; opacity: 0.85; display: inline-block;"></span>
                      </div>
                      <% } %>
        </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5-PILLARS HORIZONTAL STRIP (ENCLOSED IN ROYAL GOLD PILLARS FRAME) -->
  <!-- ========================================================================= -->
  <div
    style="position: relative; width: 100%; box-sizing: border-box; margin-bottom: 14px; padding: 10px 18px; min-height: 54px; display: flex; align-items: center; justify-content: center; page-break-inside: avoid; break-inside: avoid; filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.08));">

    <!-- Inline Premium Royal Gold Frame (Exact match to encamp-prive/public/images/pillars_frame.svg) -->
    <svg
      viewBox="0 0 1000 140"
      preserveAspectRatio="none"
      style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;"
      xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Premium Polished Gold Gradient -->
        <linearGradient id="premiumGoldPillars" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#8B6914"/>
          <stop offset="18%" stop-color="#C9A13E"/>
          <stop offset="35%" stop-color="#E8D07A"/>
          <stop offset="50%" stop-color="#F5E6A3"/>
          <stop offset="65%" stop-color="#E8D07A"/>
          <stop offset="82%" stop-color="#C9A13E"/>
          <stop offset="100%" stop-color="#8B6914"/>
        </linearGradient>

        <!-- Subtle Inner Gold Gradient -->
        <linearGradient id="innerGoldPillars" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#A0842A" stop-opacity="0.45"/>
          <stop offset="50%" stop-color="#D4B65C" stop-opacity="0.55"/>
          <stop offset="100%" stop-color="#A0842A" stop-opacity="0.45"/>
        </linearGradient>

        <!-- Elegant Soft Shadow -->
        <filter id="frameShadowPillars" x="-3%" y="-8%" width="106%" height="116%">
          <feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="#2C1A00" flood-opacity="0.12"/>
        </filter>
      </defs>

      <!-- White Card Base — Royal Curved Silhouette -->
      <path
        d="M 30,10
           L 435,10 Q 465,10 482,4 L 500,0 L 518,4 Q 535,10 565,10
           L 970,10 Q 992,10 992,32
           L 992,108 Q 992,130 970,130
           L 565,130 Q 535,130 518,136 L 500,140 L 482,136 Q 465,130 435,130
           L 30,130 Q 8,130 8,108
           L 8,32 Q 8,10 30,10 Z"
        fill="#ffffff" filter="url(#frameShadowPillars)"/>

      <!-- Outer Gold Border -->
      <path
        d="M 30,10
           L 435,10 Q 465,10 482,4 L 500,0 L 518,4 Q 535,10 565,10
           L 970,10 Q 992,10 992,32
           L 992,108 Q 992,130 970,130
           L 565,130 Q 535,130 518,136 L 500,140 L 482,136 Q 465,130 435,130
           L 30,130 Q 8,130 8,108
           L 8,32 Q 8,10 30,10 Z"
        fill="none" stroke="url(#premiumGoldPillars)" stroke-width="2.5"/>

      <!-- Inner Inset Gold Border (follows same royal curve) -->
      <path
        d="M 36,18
           L 433,18 Q 460,18 476,12 L 500,7 L 524,12 Q 540,18 567,18
           L 964,18 Q 984,18 984,36
           L 984,104 Q 984,122 964,122
           L 567,122 Q 540,122 524,128 L 500,133 L 476,128 Q 460,122 433,122
           L 36,122 Q 16,122 16,104
           L 16,36 Q 16,18 36,18 Z"
        fill="none" stroke="url(#innerGoldPillars)" stroke-width="0.8"/>

      <!-- Corner Flourishes — Elegant Curved Scrolls -->
      <g fill="none" stroke="url(#premiumGoldPillars)" stroke-width="1.4" stroke-linecap="round">
        <path d="M 22,38 Q 22,20 40,20"/>
        <path d="M 978,38 Q 978,20 960,20"/>
        <path d="M 978,102 Q 978,120 960,120"/>
        <path d="M 22,102 Q 22,120 40,120"/>
      </g>

      <!-- Corner Accent Dots -->
      <g fill="url(#premiumGoldPillars)">
        <circle cx="28" cy="26" r="1.2"/>
        <circle cx="972" cy="26" r="1.2"/>
        <circle cx="972" cy="114" r="1.2"/>
        <circle cx="28" cy="114" r="1.2"/>
      </g>

      <!-- Top Center Diamond Crest -->
      <polygon points="500,0 506,6 500,12 494,6" fill="url(#premiumGoldPillars)"/>

      <!-- Bottom Center Diamond Crest -->
      <polygon points="500,128 506,134 500,140 494,134" fill="url(#premiumGoldPillars)"/>
    </svg>

    <!-- 5-Pillars Content Grid (Placed Above SVG with z-index: 2) -->
    <div
      style="position: relative; z-index: 2; width: 100%; display: grid; grid-template-columns: repeat(5, 1fr); text-align: center; color: #123B2A; box-sizing: border-box; padding: 4px 6px;">

      <!-- 1. Handpicked -->
      <div
        style="display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid rgba(201, 161, 62, 0.35); padding: 2px 4px;">
        <svg viewBox="0 0 24 24"
          style="width: 17px; height: 17px; fill: none; stroke: #123B2A; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 2px;">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
        <span
          style="font-size: 7.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #123B2A; white-space: nowrap;"
          class="pdf-font-sans">HANDPICKED</span>
      </div>

      <!-- 2. Exclusive Stays -->
      <div
        style="display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid rgba(201, 161, 62, 0.35); padding: 2px 4px;">
        <svg viewBox="0 0 24 24"
          style="width: 17px; height: 17px; fill: none; stroke: #123B2A; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 2px;">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span
          style="font-size: 7.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #123B2A; white-space: nowrap;"
          class="pdf-font-sans">EXCLUSIVE STAYS</span>
      </div>

      <!-- 3. Local Experts -->
      <div
        style="display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid rgba(201, 161, 62, 0.35); padding: 2px 4px;">
        <svg viewBox="0 0 24 24"
          style="width: 17px; height: 17px; fill: none; stroke: #123B2A; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 2px;">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <polyline points="17 11 19 13 23 9"></polyline>
        </svg>
        <span
          style="font-size: 7.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #123B2A; white-space: nowrap;"
          class="pdf-font-sans">LOCAL EXPERTS</span>
      </div>

      <!-- 4. 24x7 Support -->
      <div
        style="display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid rgba(201, 161, 62, 0.35); padding: 2px 4px;">
        <svg viewBox="0 0 24 24"
          style="width: 17px; height: 17px; fill: none; stroke: #123B2A; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 2px;">
          <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
          <path
            d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z">
          </path>
        </svg>
        <span
          style="font-size: 7.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #123B2A; white-space: nowrap;"
          class="pdf-font-sans">24X7 SUPPORT</span>
      </div>

      <!-- 5. Sustainable -->
      <div
        style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2px 4px;">
        <svg viewBox="0 0 24 24"
          style="width: 17px; height: 17px; fill: none; stroke: #123B2A; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 2px;">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
          <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
        </svg>
        <span
          style="font-size: 7.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #123B2A; white-space: nowrap;"
          class="pdf-font-sans">SUSTAINABLE</span>
      </div>

    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 3. JOURNEY OVERVIEW -->
  <!-- ========================================================================= -->
  <section
    style="background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 16px; padding: 16px; margin-bottom: 16px; box-sizing: border-box; page-break-inside: avoid; break-inside: avoid;">
    <div style="margin-bottom: 10px;">
      <h3
        style="font-size: 20px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; margin: 0; display: flex; align-items: center; gap: 6px;"
        class="pdf-font-serif">
        <span style="color: #123B2A;">JOURNEY</span>
        <span style="color: #123B2A;">OVERVIEW</span>
      </h3>
    </div>

    <% if (itinerary.overviewText) { %>
      <div style="font-size: 11px; color: #374151; line-height: 1.65; margin-bottom: 14px;" class="pdf-font-sans">
        <%- itinerary.overviewText %>
      </div>
      <% } else if (itinerary.subtitle) { %>
        <p style="font-size: 11px; color: #374151; line-height: 1.65; margin: 0 0 14px 0;" class="pdf-font-sans">
          <%= itinerary.subtitle %>
        </p>
        <% } %>

          <!-- 4 Stat Metrics Grid -->
          <div
            style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; border: 1px solid #E5E7EB; border-radius: 16px; padding: 10px 8px; background-color: #FFFFFF; text-align: center; box-sizing: border-box;">

            <!-- 1. Days -->
            <div
              style="display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid #E5E7EB; padding: 2px;">
              <% if (calendarIconSrc) { %>
                <img src="<%= calendarIconSrc %>" alt="Days"
                  style="width: 42px; height: 42px; object-fit: contain; margin-bottom: 4px; display: block;" />
                <% } else { %>
                  <svg style="width: 36px; height: 36px; margin-bottom: 4px;" viewBox="0 0 24 24" fill="none"
                    stroke="#123B2A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <% } %>
                    <div style="font-size: 19px; font-weight: 700; color: #123B2A; line-height: 1; margin: 0;"
                      class="pdf-font-serif">
                      <%= days %>
                    </div>
                    <div
                      style="font-size: 8px; font-weight: 700; color: #6B7280; text-transform: uppercase; letter-spacing: 0.8px; margin-top: 3px;"
                      class="pdf-font-sans">DAYS</div>
            </div>

            <!-- 2. Nights -->
            <div
              style="display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid #E5E7EB; padding: 2px;">
              <% if (nightIconSrc) { %>
                <img src="<%= nightIconSrc %>" alt="Nights"
                  style="width: 42px; height: 42px; object-fit: contain; margin-bottom: 4px; display: block;" />
                <% } else { %>
                  <svg style="width: 36px; height: 36px; margin-bottom: 4px;" viewBox="0 0 24 24" fill="none"
                    stroke="#123B2A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                  </svg>
                  <% } %>
                    <div style="font-size: 19px; font-weight: 700; color: #123B2A; line-height: 1; margin: 0;"
                      class="pdf-font-serif">
                      <%= nights %>
                    </div>
                    <div
                      style="font-size: 8px; font-weight: 700; color: #6B7280; text-transform: uppercase; letter-spacing: 0.8px; margin-top: 3px;"
                      class="pdf-font-sans">NIGHTS</div>
            </div>

            <!-- 3. Experiences -->
            <div
              style="display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid #E5E7EB; padding: 2px;">
              <% if (hillIconSrc) { %>
                <img src="<%= hillIconSrc %>" alt="Experiences"
                  style="width: 42px; height: 42px; object-fit: contain; margin-bottom: 4px; display: block;" />
                <% } else { %>
                  <svg style="width: 36px; height: 36px; margin-bottom: 4px;" viewBox="0 0 24 24" fill="none"
                    stroke="#123B2A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 3l4 8 5-5 5 15H2L8 3z"></path>
                  </svg>
                  <% } %>
                    <div style="font-size: 19px; font-weight: 700; color: #123B2A; line-height: 1; margin: 0;"
                      class="pdf-font-serif">
                      <%= totalActivities ? totalActivities + '+' : '30+' %>
                    </div>
                    <div
                      style="font-size: 8px; font-weight: 700; color: #6B7280; text-transform: uppercase; letter-spacing: 0.8px; margin-top: 3px;"
                      class="pdf-font-sans">EXPERIENCES</div>
            </div>

            <!-- 4. Unforgettable Journey -->
            <div
              style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2px;">
              <% if (diamondIconSrc) { %>
                <img src="<%= diamondIconSrc %>" alt="Journey"
                  style="width: 42px; height: 42px; object-fit: contain; margin-bottom: 4px; display: block;" />
                <% } else { %>
                  <svg style="width: 36px; height: 36px; margin-bottom: 4px;" viewBox="0 0 24 24" fill="none"
                    stroke="#123B2A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3h12l4 6-10 12L2 9z"></path>
                    <path d="M11 3v18"></path>
                  </svg>
                  <% } %>
                    <div style="font-size: 19px; font-weight: 700; color: #123B2A; line-height: 1; margin: 0;"
                      class="pdf-font-serif">1</div>
                    <div
                      style="font-size: 7.5px; font-weight: 700; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 3px;"
